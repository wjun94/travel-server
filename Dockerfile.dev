FROM golang:1.26.3-alpine

WORKDIR /app

# 安装开发工具
RUN go install github.com/air-verse/air@latest
RUN go install github.com/swaggo/swag/cmd/swag@latest

# 复制依赖文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源码（通过挂载，实际在运行时覆盖）
COPY . .

# 生成swagger文档 + 启动热重载
CMD ["sh", "-c", "swag init -g cmd/main.go -o docs && air"]